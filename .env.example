# Copy these values into the environment used to start the local API.
# Do not commit real hostnames, usernames, key paths, or credentials.
OCR_BENCH_DGX_HOST=
OCR_BENCH_DGX_USER=
OCR_BENCH_DGX_PORT=22
OCR_BENCH_DGX_ROOT=
OCR_BENCH_REMOTE_LAUNCH_PYTHON=/usr/bin/python3
OCR_BENCH_SSH_KEY_PATH=
OCR_BENCH_ALLOWED_ORIGINS=

# Optional DGX runtime overrides (set on DGX, not in this example file).
OCR_BENCH_DGX_PYTHON=
OCR_BENCH_VLLM=
OCR_BENCH_QWEN25_MODEL=
OCR_BENCH_GLM_MODEL=
OCR_BENCH_INDIC_PYTHON=
